      "id": "orchestrator-live-a-period-outside-the-data-is-a-recorded-decision",
      "modes": [
        "orchestrator-live"
      ],
      "xfail": "period policy: the planner is not yet required to record a period that departs from the data's coverage as a decision, so a plan can narrow the period without saying so. Retire this marker when a departure is always a recorded decision.",
      "turns": [
        {
          "message": "How did life expectancy in Kenya change from 1900 to 2023?",
          "plan_decision": "approve",
          "expect": {
            "terminal": "done"
          }
        }
      ],
      "rubrics": [
        {
          "id": "period-departure-recorded",
          "property": "The period the plan or the answer covers is the period the user asked for, 1900 to 2023, or the departure from it is stated: as a decision with a reason on the plan card, or in the closing message when no plan was proposed. A plan that silently uses another period, or an answer that presents a shorter period as the one asked for, is a no. This property always applies and is never inapplicable."
        }
      ]
    },
    {
      "id": "orchestrator-live-every-requested-output-is-accounted-for",
      "modes": [
        "orchestrator-live"
      ],
      "xfail": "requested-output accounting: nothing yet requires each output the user asked for to be planned, declined with a code or put to the user, so one can drop out silently. Retire this marker when the plan maps every ask.",
      "turns": [
        {
          "message": "Show Kenya's life expectancy as a line chart, give me the latest value as a stat card, and rank the East African countries by it.",
          "plan_decision": "approve",
          "expect": {
            "terminal": "done"
          }
        }
      ],
      "rubrics": [
        {
          "id": "every-ask-accounted-for",
          "property": "Each output the first message asked for (the line chart of Kenya's life expectancy, the latest value as a stat card, the ranking of the East African countries) is produced as a component, set out as a step on the plan card, declined in the closing message with its reason, or put to the user as a question. An output that is neither produced nor mentioned is a no. This property always applies and is never inapplicable."
        }
      ]
    },
