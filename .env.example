# dfo-ai local environment.
#
# `just env` (or `just setup`) copies this file to .env and fills the
# secret-backed keys from Secret Manager in dev-fin-observatory. Values already
# present in .env survive, so re-running it after an edit is safe.
#
# Non-secret defaults below are committed on purpose: they are the values a
# local run should use, and keeping them in git is what keeps every developer's
# .env in sync without anyone passing settings around.

### Model access (required) ###

# Gemini API key. google-adk reads this straight from the process environment
# (not through pydantic-settings), which is why `just dev` runs the server under
# `uv run --env-file .env`.
# Secret Manager: dfo-dev-gemini-api-key, the same secret dcp and apis read.
GOOGLE_API_KEY=

# Gemini model the harness agent runs (common.settings.BaseServiceSettings.model_name).
MODEL_NAME=gemini-3.8-flash

# Model the planner agent runs, pinned to a concrete version rather than
# the floating alias above so an eval score stays attributable to one model
# (planner.settings.AgentSettings).
PLANNER_MODEL_NAME=gemini-3.8-flash

# Vertex AI instead of the Gemini API. Leave false to use GOOGLE_API_KEY above.
# Set true to authenticate via ADC against the project and location below.
GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_CLOUD_PROJECT=dev-fin-observatory
# GOOGLE_CLOUD_LOCATION=northamerica-northeast1

### Tracing (optional) ###

# Langfuse Cloud EU. Set all three keys below to export spans. Otherwise spans
# go to OTEL_EXPORTER_OTLP_ENDPOINT (below) when it is set, and tracing is off
# when it is not. The harness reports the state as `telemetry` on /healthz.
# Secret Manager: dfo-dev-langfuse-public-key / dfo-dev-langfuse-secret-key.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional: tags every trace with an environment, which separates deployed
# traces from local ones in a shared Langfuse project (for example `dev`).
# LANGFUSE_TRACING_ENVIRONMENT=

# Generic OTLP/HTTP exporter, read only when the Langfuse trio above is incomplete.
# OTEL_EXPORTER_OTLP_ENDPOINT=

### Upstream services ###

# Base URL of apis, the FastAPI app that serves the Search, Datasets and
# presentation surfaces the MCP servers wrap. Cloud Run IAM guards the dev
# deployment, so local runs reach it through `just apis-proxy` (`gcloud run
# services proxy dfo-dev-apis --port 8083`), which signs each request as your
# gcloud account. A `just dev` in an apis checkout serves the same port.
# Deployed, each service sends its own Cloud Run ID token. Locally it sends none.
DFO_APIS_URL=http://localhost:8083

# Public origin of the website (scheme and host, no path), e.g.
# https://developmentfinance.org. data-mcp puts the artifact download links it
# hands to models on it: the website proxies /api/datasets/* to apis with
# its own ID token, so the links work for anyone who can reach the site. Cloud
# Run requires it and data-mcp refuses to start without it there. Unset locally,
# the links sit on DFO_APIS_URL, which the gcloud proxy or a local apis
# answers without a token.
# DFO_SITE_ORIGIN=

# The principal apis grants publish to, sent as the x-dfo-principal header.
# presentation-mcp sends it when it publishes a derived (ops_/ocv_) frame, and on
# the card creates and revises of Studio conversations, which reach it over the
# harness's loopback mount. apis exempts a principal holding the publish grant
# from the per-caller card allowance, so Studio's cards spend none. A card an
# external MCP client writes through /mcp never carries it. Must equal the
# DATASETS_FIRST_PARTY_PRINCIPAL the apis deployment holds; nothing keeps the
# two in sync but a deployer setting the same value on both. Left blank, cards
# on an analysis result still draw, since apis' analysis runner published that
# frame, Studio's cards spend the one allowance of the address apis sees for
# this service, and a live share's redraw refuses `refresh_not_configured`.
# `just env` fills this from Secret Manager.
DATASETS_FIRST_PARTY_PRINCIPAL=

# The secret apis shares with the website (apis' DFO_CALLER_PRINCIPAL), which
# vouches for the caller the website names in x-dfo-caller. The website names
# each /mcp client as ip:<digest>. analysis-mcp sends the secret and that
# caller with each analysis runner call, and presentation-mcp with each card
# an external client creates or revises, so apis counts the client's own
# allowance. Left blank, neither sends a caller: runner calls are not
# attributed to a client, and every external client's cards spend the one
# allowance of the address apis sees for this service.
DFO_CALLER_PRINCIPAL=

### Runtime ###

# Port the harness binds. data-mcp, analysis-mcp, and presentation-mcp
# share it, as ASGI sub-apps mounted inside the harness.
PORT=8080

# Override the in-process loopback MCP URLs. Left blank, harness.settings derives
# them from PORT. Set these only to point at a split-out standalone MCP service,
# and use https -- the shared MCP_API_TOKEN below is attached to every request,
# so startup refuses an off-loopback URL over plain http even with one set.
# DATA_MCP_URL=
# ANALYSIS_MCP_URL=
# PRESENTATION_MCP_URL=

# URL a browser reaches presentation-mcp at, mount path included. Every view's
# payload names its theme stylesheet as <this>/theme-<hash>.css and the renderer's
# CSP admits its origin. Required: presentation-mcp refuses to start without an
# absolute http(s) URL here, with no query, fragment, or credentials. The value
# below is the local harness on the default PORT, and the justfile recipes that
# start the harness derive theirs from PORT. A deployment sets its public https
# URL plus /mcp/presentation, and the Cloud Run service must set it, in
# infra.
PRESENTATION_PUBLIC_URL=http://localhost:8080/mcp/presentation

# Whether presentation-mcp must mount its tools to start. Deployments leave it
# unset, which means true: startup retries an unreachable platform for up to
# RELEASE_STARTUP_DEADLINE_S (90 s) and then fails. Local development sets it
# false, so the harness starts at once, without presentation tools, when no
# apis answers at DFO_APIS_URL. `just dev` sets false itself.
PRESENTATION_RELEASE_REQUIRED=false

# Durable ADK chat sessions via DatabaseSessionService, over a plain
# SQLAlchemy URL (local Postgres or sqlite). Unset means in-memory sessions,
# which is the right default for local dev. Mutually exclusive with
# SESSION_STORE_INSTANCE_CONNECTION_NAME below.
# DATABASE_URL=

# Durable ADK chat sessions via DatabaseSessionService, over an async engine
# built on the Cloud SQL Python Connector (PSC, IAM auth) -- the deployed
# `ai` Cloud Run instance's path to the platform Postgres instance. Mutually
# exclusive with DATABASE_URL above. SESSION_STORE_DATABASE and
# SESSION_STORE_RUNTIME_DB_USER are required with it.
# SESSION_STORE_INSTANCE_CONNECTION_NAME=
# SESSION_STORE_DATABASE=
# SESSION_STORE_RUNTIME_DB_USER=

# Pooled connections `create_async_engine` opens for the connector-backed
# engine above. Unset uses the class defaults (2 and 0) -- two per
# instance. A rollout can leave an old revision still draining SSE streams
# running alongside the new one, so up to four instances hold connections
# at once, and four times two stays within the ten connections the infra repository's
# platform Postgres instance reserves for it.
# SESSION_STORE_POOL_SIZE=
# SESSION_STORE_MAX_OVERFLOW=

# Bounds one Cloud SQL Connector dial attempt, in seconds. Unset uses the
# class default (30), matching apis' DATASET_STORE_CONNECT_TIMEOUT.
# SESSION_STORE_CONNECT_TIMEOUT_S=

# GCS bucket backing data-mcp's search-write definition store (infra
# provisions it). Unset means an in-memory store, the right default for
# local dev, same pattern as DATABASE_URL above.
# DEFINITION_STORE_BUCKET=

# Max entries the definition store's read cache holds before evicting the
# least-recently-used one. Unset uses the class default (4096).
# DEFINITION_STORE_CACHE_MAX_ENTRIES=

# GCS bucket backing the frame materialisation store data-mcp and
# analysis-mcp share (infra provisions it). Unset means an in-memory
# store, the right default for local dev, same pattern as
# DEFINITION_STORE_BUCKET above -- but process-local, so no other instance
# (and not a restart) can see what it holds.
# FRAME_STORE_BUCKET=

# Gates the durable frame store's own re-derivation check on every read.
# Unset (off) trusts a read's stored content_version without recomputing
# it, since recomputing costs a full frame-grammar pass per read.
# FRAME_STORE_VERIFY_CONTENT_VERSION=

# Force log formatting: "json" or "text". Unset auto-detects -- JSON on Cloud Run
# (where K_SERVICE is set), text locally.
# LOG_FORMAT=

# Shared secret for the studio routes. Placeholder access control: with this
# unset a live server accepts any non-empty bearer token and logs a warning.
# The same value goes on the Cloud Run service and in the frontend proxy.
STUDIO_API_TOKEN=

# The credential of POST /api/studio/refresh, which the website calls server to
# server to redraw a live share's derived card, and the principal the harness
# presents to apis' frame refresh and render routes. apis, this service
# and the website hold one value. Left blank, the route refuses every caller
# with 401 and the server logs "LIVE REFRESH IS CLOSED". It must differ from
# STUDIO_API_TOKEN. The route also needs DFO_APIS_URL and
# DATASETS_FIRST_PARTY_PRINCIPAL above.
LIVE_REFRESH_PRINCIPAL=

# The refresh route's deadline and limits, with their defaults. A refresh starts
# no new step after the deadline and is cut 8 s later, so the deadline must stay
# 8 s under the caller's timeout (the website's is 60 s). Startup fails for a
# value above 52 or below 30, the least that can mint a root. The rate, burst
# and in-flight cap are per instance and apart from the combined MCP server's.
# The row budget caps the frame rows replays put through the tools at once.
# LIVE_REFRESH_DEADLINE_S=45
# LIVE_REFRESH_REQUESTS_PER_S=2
# LIVE_REFRESH_BURST=20
# LIVE_REFRESH_MAX_IN_FLIGHT=8
# LIVE_REFRESH_ROWS_IN_FLIGHT_MAX=500000

# Reasoning effort of the orchestrator agent: LOW, MEDIUM or HIGH. Unset or
# blank means LOW.
# ORCHESTRATOR_THINKING_LEVEL=

# Shared bearer token the data-mcp/analysis-mcp/presentation-mcp MCP mounts
# require (common.auth). Left blank, the harness mints one at startup that
# only its own process knows: its own MCP clients work, and every external
# caller -- curl, the dfo-ai-e2e test daemon -- gets a 401 on every mount.
# `just env` fills this from Secret Manager so those callers work without
# each developer inventing a value. Required when pointing DATA_MCP_URL /
# ANALYSIS_MCP_URL / PRESENTATION_MCP_URL at a split-out deployment; startup
# refuses that combination without a token.
MCP_API_TOKEN=

# Turns the MCP mount gate off entirely, for a raw client with no bearer
# token to present. Logged at error level. Never set this on a deployment
# reachable beyond your own machine.
# MCP_AUTH_DISABLED=true
